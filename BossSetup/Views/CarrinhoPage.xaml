<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:BossSetup.Controls"
             x:Class="BossSetup.Views.CarrinhoPage"
             Title="Carrinho"
             BackgroundColor="{StaticResource BossBackground}"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">

        <controls:PageTopBar x:Name="topBar"
                             Grid.Row="0"
                             Titulo="Carrinho" />

        <CollectionView Grid.Row="1"
                        x:Name="collectionCarrinho"
                        Margin="12,8">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Style="{StaticResource BossCard}" Margin="0,4">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding Nome}"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="White"/>
                            <Label Text="{Binding Preco, StringFormat='R$ {0:F2}'}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource BossSuccess}"/>
                            <Button Text="Remover"
                                    Style="{StaticResource BtnSecondary}"
                                    HorizontalOptions="Start"
                                    Clicked="OnRemoverClicked"
                                    CommandParameter="{Binding .}"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <VerticalStackLayout Grid.Row="2"
                             Padding="16,8,16,16"
                             Spacing="10"
                             BackgroundColor="{StaticResource BossSurface}">

            <Label x:Name="lblTotal"
                   Text="Total: R$ 0,00"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="White"/>

            <Button Text="Finalizar compra"
                    Style="{StaticResource BtnPrimary}"
                    Clicked="OnFinalizarClicked"/>

        </VerticalStackLayout>

    </Grid>
</ContentPage>
