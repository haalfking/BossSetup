<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:BossSetup.Helpers"
             xmlns:controls="clr-namespace:BossSetup.Controls"
             x:Class="BossSetup.Views.ProdutosPage"
             Title="Produtos"
             BackgroundColor="{StaticResource BossBackground}"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*" Padding="0">

        <controls:PageTopBar x:Name="topBar"
                             Grid.Row="0"
                             Titulo="Produtos"
                             TextoAcao="🛒 Carrinho" />

        <CollectionView Grid.Row="1"
                        x:Name="collectionProdutos"
                        Margin="12,8,12,12"
                        SelectionMode="None">

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Frame Style="{StaticResource BossCard}"
                           Margin="4"
                           Padding="10">

                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnItemTapped"
                                                  CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>

                        <VerticalStackLayout Spacing="6">

                            <Frame Padding="0"
                                   CornerRadius="12"
                                   HeightRequest="140"
                                   IsClippedToBounds="True"
                                   BackgroundColor="White"
                                   HasShadow="False">
                                <Image Source="{Binding Imagem}" Aspect="AspectFit"/>
                            </Frame>

                            <Label Text="{Binding Nome}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="White"/>

                            <Label Text="{Binding Descricao}"
                                   FontSize="11"
                                   TextColor="{StaticResource BossTextMuted}"
                                   MaxLines="2"/>

                            <Label Text="{Binding Categoria}"
                                   FontSize="11"
                                   TextColor="{StaticResource BossAccent}"/>

                            <Label Text="{Binding Preco, StringFormat='R$ {0:F2}'}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource BossSuccess}"/>

                            <Label Text="{Binding Estoque, StringFormat='Estoque: {0}'}"
                                   FontSize="11"
                                   TextColor="White"/>

                            <HorizontalStackLayout Spacing="6">

                                <Button Text="Comprar"
                                        Style="{StaticResource BtnSuccess}"
                                        Clicked="OnAddCarrinhoClicked"
                                        CommandParameter="{Binding .}"/>

                                <Button Text="Excluir"
                                        Style="{StaticResource BtnDanger}"
                                        IsVisible="{Binding Source={x:Static helpers:AppState.IsAdmin}}"
                                        Clicked="OnExcluirClicked"
                                        CommandParameter="{Binding Id}"/>

                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                    </Frame>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>
