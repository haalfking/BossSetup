<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BossSetup.Views.ProdutosPage"
             Title="Produtos"
             BackgroundColor="Black"
             NavigationPage.HasNavigationBar="False">

    <!-- TROQUEI VerticalStackLayout POR GRID (ESSENCIAL PARA SCROLL) -->
    <Grid RowDefinitions="Auto,*" Padding="20">

        <!-- 🛒 BOTÃO DO CARRINHO + LOGO -->
        <VerticalStackLayout Grid.Row="0" Spacing="10">

            <Button Text="🛒 Ver Carrinho"
                    BackgroundColor="#121212"
                    TextColor="White"
                    Clicked="OnIrCarrinhoClicked"/>

            <Image Source="logo.png"
                   HeightRequest="180"
                   HorizontalOptions="Center"/>

        </VerticalStackLayout>

        <!-- LISTA (AGORA SCROLL FUNCIONA) -->
        <CollectionView Grid.Row="1"
                        x:Name="collectionProdutos"
                        SelectionMode="None">

            <!-- GRID 2 COLUNAS -->
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Frame BorderColor="#2C2C2C"
                           BackgroundColor="#1E1E1E"
                           CornerRadius="15"
                           Padding="10"
                           Margin="5"
                           HasShadow="True">

                        <!-- CLIQUE PARA EDITAR -->
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnItemTapped"
                                                  CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>

                        <VerticalStackLayout Spacing="5">

                            <!-- IMAGEM (CORRIGIDO AQUI 👇) -->
                            <Frame Padding="0"
                                   CornerRadius="12"
                                   HeightRequest="350"
                                   IsClippedToBounds="True"
                                   BackgroundColor="White">

                                <Image Source="{Binding Imagem}"  Aspect="AspectFit"/>

                            </Frame>

                            <!-- NOME -->
                            <Label Text="{Binding Nome}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="White"/>

                            <!-- DESCRIÇÃO -->
                            <Label Text="{Binding Descricao}"
                                   FontSize="12"
                                   TextColor="Gray"
                                   MaxLines="2"/>

                            <!-- CATEGORIA -->
                            <Label Text="{Binding Categoria}"
                                   FontSize="12"
                                   TextColor="LightBlue"/>

                            <!-- PREÇO -->
                            <Label Text="{Binding Preco, StringFormat='R$ {0:F2}'}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#00FF88"/>

                            <!-- ESTOQUE -->
                            <Label Text="{Binding Estoque, StringFormat='Estoque: {0}'}"
                                   FontSize="12"
                                   TextColor="White"/>

                            <!-- AVALIAÇÃO -->
                            <Label Text="{Binding Avaliacao, StringFormat='⭐ {0:F1}'}"
                                   FontSize="12"
                                   TextColor="Yellow"/>

                            <!-- DESTAQUE -->
                            <Label Text="{Binding Destaque, StringFormat='Destaque: {0}'}"
                                   FontSize="10"
                                   TextColor="Gray"/>

                            <!-- BOTÕES -->
                            <HorizontalStackLayout Spacing="5">

                                <Button Text="comprar"
                                        BackgroundColor="#00C853"
                                        TextColor="Black"
                                        CornerRadius="10"
                                        WidthRequest="100"
                                        Clicked="OnAddCarrinhoClicked"
                                        CommandParameter="{Binding .}"/>

                                <Button Text="Excluir"
                                        BackgroundColor="Gray"
                                        TextColor="Black"
                                        CornerRadius="10"
                                        WidthRequest="70"
                                        Clicked="OnExcluirClicked"
                                        CommandParameter="{Binding Id}"/>

                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                    </Frame>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>