<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BossSetup.Views.ProdutosPage"
             Title="Produtos">

    <VerticalStackLayout Padding="20" Spacing="10">

        <CollectionView x:Name="collectionProdutos" SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Frame BorderColor="Gray"
                           CornerRadius="12"
                           Padding="10"
                           Margin="5">

                        <!-- CLIQUE PARA EDITAR -->
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnItemTapped"
                                                  CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>

                        <VerticalStackLayout Spacing="5">

                            <!-- Nome -->
                            <Label Text="{Binding Nome}"
                                   FontSize="18"
                                   FontAttributes="Bold"/>

                            <!-- Descrição -->
                            <Label Text="{Binding Descricao}"
                                   FontSize="14"
                                   TextColor="Gray"/>

                            <!-- Categoria -->
                            <Label Text="{Binding Categoria}"
                                   FontSize="13"
                                   TextColor="DarkBlue"/>

                            <!-- Preço -->
                            <Label Text="{Binding Preco, StringFormat='Preço: R$ {0:F2}'}"
                                   FontSize="16"
                                   TextColor="Green"/>

                            <!-- Estoque -->
                            <Label Text="{Binding Estoque, StringFormat='Estoque: {0}'}"
                                   FontSize="13"/>

                            <!-- Avaliação -->
                            <Label Text="{Binding Avaliacao, StringFormat='⭐ {0:F1}'}"
                                   FontSize="13"/>

                            <!-- Destaque -->
                            <Label Text="{Binding Destaque, StringFormat='Destaque: {0}'}"
                                   FontSize="12"
                                   TextColor="Red"/>

                            <!-- Imagem -->
                            <Image Source="{Binding Imagem}"
                                   HeightRequest="120"
                                   Aspect="AspectFill"/>

                            <!-- BOTÃO EXCLUIR -->
                            <Button Text="Excluir"
                                    BackgroundColor="Red"
                                    TextColor="White"
                                    Clicked="OnExcluirClicked"
                                    CommandParameter="{Binding Id}"/>

                        </VerticalStackLayout>

                    </Frame>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </VerticalStackLayout>
</ContentPage>