<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BossSetup.Views.ProdutosPage"
             Title="Produtos"
             BackgroundColor="Black"
             NavigationPage.HasNavigationBar="False">

    <VerticalStackLayout Padding="20" Spacing="10">

        <!-- 🛒 BOTÃO DO CARRINHO -->
        <Button Text="🛒 Ver Carrinho"
                BackgroundColor="#121212"
                TextColor="White"
                Clicked="OnIrCarrinhoClicked"/>

        <Image Source="logo..png"
         HeightRequest="350"
         HorizontalOptions="Center"/>

        <CollectionView x:Name="collectionProdutos" SelectionMode="None">

            <!-- GRID 2 COLUNAS -->
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Frame BorderColor="#2C2C2C"
                           BackgroundColor="#1E1E1E"
                           CornerRadius="15"
                           Padding="10"
                           Margin="5"
                           HasShadow="True">

                        <!-- CLIQUE PARA EDITAR -->
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnItemTapped"
                                                  CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>

                        <VerticalStackLayout Spacing="5">

                            <!-- IMAGEM -->
                            <Image Source="{Binding Imagem}"
                                   HeightRequest="350"
                                   Aspect="AspectFill"/>

                            <!-- NOME -->
                            <Label Text="{Binding Nome}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="White"/>

                            <!-- DESCRIÇÃO -->
                            <Label Text="{Binding Descricao}"
                                   FontSize="12"
                                   TextColor="Gray"
                                   MaxLines="2"/>

                            <!-- CATEGORIA -->
                            <Label Text="{Binding Categoria}"
                                   FontSize="12"
                                   TextColor="LightBlue"/>

                            <!-- PREÇO -->
                            <Label Text="{Binding Preco, StringFormat='R$ {0:F2}'}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#00FF88"/>

                            <!-- ESTOQUE -->
                            <Label Text="{Binding Estoque, StringFormat='Estoque: {0}'}"
                                   FontSize="12"
                                   TextColor="White"/>

                            <!-- AVALIAÇÃO -->
                            <Label Text="{Binding Avaliacao, StringFormat='⭐ {0:F1}'}"
                                   FontSize="12"
                                   TextColor="Yellow"/>

                            <!-- DESTAQUE -->
                            <Label Text="{Binding Destaque, StringFormat='Destaque: {0}'}"
                                   FontSize="6"
                                   TextColor="Gray"/>

                            <!-- BOTÕES -->
                            <HorizontalStackLayout Spacing="5">

                                <Button Text="comprar"
                                        BackgroundColor="#00C853"
                                        TextColor="Black"
                                        CornerRadius="10"
                                        WidthRequest="100"
                                        Clicked="OnAddCarrinhoClicked"
                                        CommandParameter="{Binding .}"/>

                                <Button Text="Excluir"
                                        BackgroundColor="Gray"
                                        TextColor="Black"
                                        CornerRadius="10"
                                        WidthRequest="70"
                                        Clicked="OnExcluirClicked"
                                        CommandParameter="{Binding Id}"/>

                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                    </Frame>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </VerticalStackLayout>
</ContentPage>