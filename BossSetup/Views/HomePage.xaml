<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BossSetup.Views.HomePage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource BossBackground}">

    <Grid RowDefinitions="Auto,*">

        <!-- Topo: saudação à esquerda, carrinho e sair à direita -->
        <Grid Grid.Row="0"
              Padding="16,12,16,0"
              ColumnDefinitions="*,Auto">
            <Label Grid.Column="0"
                   x:Name="lblSaudacao"
                   FontFamily="OpenSansRegular"
                   FontSize="14"
                   TextColor="{StaticResource BossTextMuted}"
                   VerticalOptions="Center"/>
            <HorizontalStackLayout Grid.Column="1"
                                   Spacing="8"
                                   VerticalOptions="Center">
                <Button x:Name="btnCarrinho"
                        Text="🛒 Carrinho"
                        Style="{StaticResource BtnNavBar}"
                        Clicked="OnCarrinhoClicked"/>
                <Button x:Name="btnSair"
                        Text="Sair"
                        Style="{StaticResource BtnCompact}"
                        Clicked="OnSairClicked"/>
            </HorizontalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,0,20,24" Spacing="20">

                <!-- Logo -->
                <Image Source="logo.png"
                       HeightRequest="260"
                       WidthRequest="260"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       Margin="0,4,0,0"/>

                <!-- Slogan -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Monte o Setup dos Seus Sonhos"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="Periféricos, hardware e acessórios gamers com qualidade."
                           FontSize="14"
                           TextColor="{StaticResource BossTextMuted}"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <!-- Botões -->
                <VerticalStackLayout Spacing="10"
                                     HorizontalOptions="Center">

                    <Button x:Name="btnVerProdutos"
                            Text="Ver produtos"
                            Style="{StaticResource BtnSecondary}"
                            HorizontalOptions="Center"
                            WidthRequest="220"
                            Clicked="OnVerProdutosClicked"/>

                    <VerticalStackLayout x:Name="painelAdmin"
                                         Spacing="10"
                                         HorizontalOptions="Center"
                                         IsVisible="False">

                        <Button x:Name="btnCadastrarProduto"
                                Text="Cadastrar produtos"
                                Style="{StaticResource BtnSecondary}"
                                HorizontalOptions="Center"
                                WidthRequest="220"
                                Clicked="OnCadastrarProdutoClicked"/>

                        <Button x:Name="btnGerenciarUsuarios"
                                Text="Gerenciar usuários"
                                Style="{StaticResource BtnSecondary}"
                                HorizontalOptions="Center"
                                WidthRequest="220"
                                Clicked="OnGerenciarUsuariosClicked"/>

                    </VerticalStackLayout>

                </VerticalStackLayout>

                <!-- Destaques em carrossel horizontal -->
                <Frame Style="{StaticResource BossCard}">

                    <VerticalStackLayout Spacing="12">

                        <Label Text="Produtos em destaque"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="White"/>

                        <Label x:Name="lblSemDestaques"
                               Text="Nenhum produto em destaque no momento."
                               TextColor="{StaticResource BossTextMuted}"
                               HorizontalTextAlignment="Center"
                               IsVisible="False"/>

                        <CollectionView x:Name="collectionDestaques"
                                        ItemsSource="{Binding ProdutosDestaque}"
                                        HeightRequest="300"
                                        SelectionMode="None">

                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal"
                                                   ItemSpacing="12"
                                                   SnapPointsType="MandatorySingle"
                                                   SnapPointsAlignment="Start"/>
                            </CollectionView.ItemsLayout>

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame BackgroundColor="{StaticResource BossSurfaceLight}"
                                           BorderColor="#2C2C2C"
                                           CornerRadius="14"
                                           Padding="12"
                                           WidthRequest="175"
                                           HasShadow="False">
                                        <VerticalStackLayout Spacing="8">

                                            <Image Source="{Binding Imagem}"
                                                   HeightRequest="90"
                                                   Aspect="AspectFit"/>

                                            <Label Text="{Binding Nome}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="White"
                                                   MaxLines="2"
                                                   LineBreakMode="TailTruncation"/>

                                            <Label Text="{Binding Preco, StringFormat='R$ {0:F2}'}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource BossAccent}"/>

                                            <Button Text="Comprar"
                                                    Style="{StaticResource BtnSuccess}"
                                                    FontSize="12"
                                                    Clicked="OnComprarDestaqueClicked"
                                                    CommandParameter="{Binding .}"/>

                                        </VerticalStackLayout>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>

                        </CollectionView>

                    </VerticalStackLayout>

                </Frame>

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="10">

                    <Frame Grid.Column="0" Style="{StaticResource BossCard}" Padding="12">
                        <VerticalStackLayout>
                            <Label Text="🚚" FontSize="28" HorizontalOptions="Center"/>
                            <Label Text="Entrega Rápida"
                                   HorizontalOptions="Center"
                                   TextColor="White"
                                   FontSize="13"/>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Column="1" Style="{StaticResource BossCard}" Padding="12">
                        <VerticalStackLayout>
                            <Label Text="🔒" FontSize="28" HorizontalOptions="Center"/>
                            <Label Text="Compra Segura"
                                   HorizontalOptions="Center"
                                   TextColor="White"
                                   FontSize="13"/>
                        </VerticalStackLayout>
                    </Frame>

                </Grid>

                <Frame Style="{StaticResource BossCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Sobre a Boss Setup"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="White"/>
                        <Label Text="A Boss Setup oferece periféricos, hardware e acessórios gamers para elevar seu desempenho e transformar seu setup."
                               TextColor="{StaticResource BossTextMuted}"/>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
