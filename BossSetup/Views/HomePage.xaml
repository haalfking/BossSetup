<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BossSetup.Views.HomePage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource BossBackground}">

    <Grid RowDefinitions="Auto,*">

        <!-- Sair no canto superior direito -->
        <Grid Grid.Row="0"
              Padding="16,12,16,0"
              ColumnDefinitions="*,Auto">
            <Button Grid.Column="1"
                    x:Name="btnSair"
                    Text="Sair"
                    Style="{StaticResource BtnCompact}"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Clicked="OnSairClicked"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,0,20,24" Spacing="20">

                <!-- Hero: logo + ver produtos -->
                <VerticalStackLayout Spacing="20"
                                     HorizontalOptions="Center"
                                     Margin="0,8,0,8">

                    <Image Source="logo.png"
                           HeightRequest="280"
                           WidthRequest="280"
                           Aspect="AspectFit"
                           HorizontalOptions="Center"/>

                    <Button x:Name="btnVerProdutos"
                            Text="Ver produtos"
                            Style="{StaticResource BtnSecondary}"
                            HorizontalOptions="Center"
                            WidthRequest="220"
                            Clicked="OnVerProdutosClicked"/>

                    <VerticalStackLayout x:Name="painelAdmin"
                                         Spacing="10"
                                         HorizontalOptions="Center"
                                         IsVisible="False">

                        <Button x:Name="btnCadastrarProduto"
                                Text="Cadastrar produtos"
                                Style="{StaticResource BtnSecondary}"
                                HorizontalOptions="Center"
                                WidthRequest="220"
                                Clicked="OnCadastrarProdutoClicked"/>

                        <Button x:Name="btnGerenciarUsuarios"
                                Text="Gerenciar usuários"
                                Style="{StaticResource BtnSecondary}"
                                HorizontalOptions="Center"
                                WidthRequest="220"
                                Clicked="OnGerenciarUsuariosClicked"/>

                    </VerticalStackLayout>

                </VerticalStackLayout>

                <Label Text="Monte o Setup dos Seus Sonhos"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center"/>

                <Label Text="Periféricos, hardware e acessórios gamers com qualidade."
                       FontSize="14"
                       TextColor="{StaticResource BossTextMuted}"
                       HorizontalTextAlignment="Center"/>

                <Frame Style="{StaticResource BossCard}">

                    <VerticalStackLayout Spacing="10">

                        <Label Text="Produtos em destaque"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="White"/>

                        <CollectionView ItemsSource="{Binding ProdutosDestaque}"
                                        HeightRequest="350">

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame BackgroundColor="{StaticResource BossSurfaceLight}"
                                           CornerRadius="14"
                                           Padding="12"
                                           Margin="0,6"
                                           HasShadow="False">
                                        <VerticalStackLayout Spacing="8">
                                            <Image Source="{Binding Imagem}"
                                                   HeightRequest="120"
                                                   Aspect="AspectFit"/>
                                            <Label Text="{Binding Nome}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="White"/>
                                            <Label Text="{Binding Descricao}"
                                                   TextColor="{StaticResource BossTextMuted}"
                                                   MaxLines="2"/>
                                            <Label Text="{Binding Preco, StringFormat='R$ {0:F2}'}"
                                                   FontSize="18"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource BossAccent}"/>
                                        </VerticalStackLayout>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>

                        </CollectionView>

                    </VerticalStackLayout>

                </Frame>

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="10">

                    <Frame Grid.Column="0" Style="{StaticResource BossCard}" Padding="12">
                        <VerticalStackLayout>
                            <Label Text="🚚" FontSize="28" HorizontalOptions="Center"/>
                            <Label Text="Entrega Rápida"
                                   HorizontalOptions="Center"
                                   TextColor="White"
                                   FontSize="13"/>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Grid.Column="1" Style="{StaticResource BossCard}" Padding="12">
                        <VerticalStackLayout>
                            <Label Text="🔒" FontSize="28" HorizontalOptions="Center"/>
                            <Label Text="Compra Segura"
                                   HorizontalOptions="Center"
                                   TextColor="White"
                                   FontSize="13"/>
                        </VerticalStackLayout>
                    </Frame>

                </Grid>

                <Frame Style="{StaticResource BossCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Sobre a Boss Setup"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="White"/>
                        <Label Text="A Boss Setup oferece periféricos, hardware e acessórios gamers para elevar seu desempenho e transformar seu setup."
                               TextColor="{StaticResource BossTextMuted}"/>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
