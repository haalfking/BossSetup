<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BossSetup.Views.LoginPage"
             BackgroundColor="{StaticResource BossBackground}"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">

            <Image Source="logo.png"
                   HeightRequest="200"
                   HorizontalOptions="Center"/>

            <Label Text="Bem-vindo"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"/>

            <Label Text="Entre na sua conta Boss Setup"
                   FontSize="14"
                   TextColor="{StaticResource BossTextMuted}"
                   HorizontalOptions="Center"/>

            <Entry x:Name="txtEmail"
                   Style="{StaticResource BossEntry}"
                   Placeholder="E-mail"/>

            <Entry x:Name="txtSenha"
                   Style="{StaticResource BossEntry}"
                   Placeholder="Senha"
                   IsPassword="True"/>

            <Label x:Name="lblMensagem"
                   TextColor="{StaticResource BossDanger}"
                   HorizontalOptions="Center"/>

            <Button Text="Entrar"
                    Style="{StaticResource BtnSecondary}"
                    Clicked="OnLoginClicked"/>

            <Button Text="Criar conta"
                    Style="{StaticResource BtnSecondary}"
                    Clicked="OnCadastroClicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
