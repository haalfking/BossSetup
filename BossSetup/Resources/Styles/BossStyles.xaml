<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style x:Key="BtnPrimary" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource BossAccent}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinimumHeightRequest" Value="42" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <Style x:Key="BtnSecondary" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource BossSurfaceLight}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinimumHeightRequest" Value="42" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <Style x:Key="BtnCompact" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource BossSurfaceLight}" />
        <Setter Property="TextColor" Value="{StaticResource BossTextMuted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinimumHeightRequest" Value="32" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <!-- Carrinho no topo: um pouco maior que BtnCompact -->
    <Style x:Key="BtnNavBar" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource BossSurfaceLight}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <Style x:Key="BtnDanger" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource BossDanger}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinimumHeightRequest" Value="42" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <Style x:Key="BtnSuccess" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource BossSuccess}" />
        <Setter Property="TextColor" Value="Black" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <Style x:Key="BossCard" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource BossSurface}" />
        <Setter Property="BorderColor" Value="#2C2C2C" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="BossEntry" TargetType="Entry">
        <Setter Property="TextColor" Value="White" />
        <Setter Property="PlaceholderColor" Value="{StaticResource BossTextMuted}" />
        <Setter Property="BackgroundColor" Value="{StaticResource BossSurface}" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

</ResourceDictionary>
